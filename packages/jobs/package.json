{
  "name": "@igniter-js/jobs",
  "version": "0.1.15",
  "description": "Type-safe jobs and workers for Igniter.js with BullMQ, Bun SQLite, and mock adapters",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "AGENTS.md"
  ],
  "exports": {
    ".": {
      "browser": "./dist/shim.js",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./telemetry": {
      "browser": "./dist/shim.js",
      "types": "./dist/telemetry/index.d.ts",
      "import": "./dist/telemetry/index.mjs",
      "require": "./dist/telemetry/index.js"
    },
    "./adapters/node": {
      "browser": "./dist/shim.js",
      "types": "./dist/adapters/node.d.ts",
      "import": "./dist/adapters/node.mjs",
      "require": "./dist/adapters/node.js"
    },
    "./adapters/bun": {
      "browser": "./dist/shim.js",
      "types": "./dist/adapters/bun.d.ts",
      "import": "./dist/adapters/bun.mjs",
      "require": "./dist/adapters/bun.js"
    },
    "./adapters/mock": {
      "browser": "./dist/shim.js",
      "types": "./dist/adapters/mock.d.ts",
      "import": "./dist/adapters/mock.mjs",
      "require": "./dist/adapters/mock.js"
    }
  },
  "browser": {
    "./dist/index.js": "./dist/shim.js",
    "./dist/telemetry/index.js": "./dist/shim.js",
    "./dist/adapters/node.js": "./dist/shim.js",
    "./dist/adapters/bun.js": "./dist/shim.js",
    "./dist/adapters/mock.js": "./dist/shim.js"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "igniter",
    "igniterjs",
    "jobs",
    "queues",
    "bullmq",
    "worker",
    "scheduler",
    "typescript",
    "type-safe"
  ],
  "author": "Felipe Barcelos <felipebarcelospro@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/felipebarcelospro/igniter-js.git",
    "directory": "packages/jobs"
  },
  "bugs": {
    "url": "https://github.com/felipebarcelospro/igniter-js/issues"
  },
  "homepage": "https://igniterjs.com",
  "dependencies": {
    "@igniter-js/common": ">=0.1.0",
    "@igniter-js/telemetry": ">=0.1.12",
    "bunqueue": "^2.6.114"
  },
  "devDependencies": {
    "@igniter-js/adapter-bullmq": "1.0.0-alpha.0",
    "@igniter-js/common": "*",
    "@igniter-js/core": "*",
    "@igniter-js/store": "*",
    "@igniter-js/telemetry": "*",
    "@types/node": "^22.7.5",
    "bullmq": "4.18.3",
    "ioredis": "^5.3.2",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "zod": "3.23.8"
  },
  "peerDependencies": {
    "@igniter-js/adapter-bullmq": ">=1.0.0-alpha.0",
    "@igniter-js/common": ">=0.1.0",
    "@igniter-js/core": "*",
    "@igniter-js/store": ">=0.1.0",
    "@igniter-js/telemetry": ">=0.1.12",
    "bullmq": ">=4.18.3",
    "ioredis": ">=5.3.2",
    "zod": ">=3.23.8"
  },
  "peerDependenciesMeta": {
    "@igniter-js/adapter-bullmq": {
      "optional": true
    },
    "@igniter-js/store": {
      "optional": true
    },
    "bullmq": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
