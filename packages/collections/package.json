{
  "name": "@igniter-js/collections",
  "version": "0.2.102",
  "description": "Type-safe content collections for Igniter.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "AGENTS.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/shim.js",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry/index.d.ts",
      "browser": "./dist/shim.js",
      "import": "./dist/telemetry/index.mjs",
      "require": "./dist/telemetry/index.js"
    },
    "./adapters/node": {
      "types": "./dist/adapters/node.d.ts",
      "browser": "./dist/shim.js",
      "import": "./dist/adapters/node.mjs",
      "require": "./dist/adapters/node.js"
    },
    "./adapters/bun": {
      "types": "./dist/adapters/bun.d.ts",
      "browser": "./dist/shim.js",
      "import": "./dist/adapters/bun.mjs",
      "require": "./dist/adapters/bun.js"
    },
    "./adapters/mock": {
      "types": "./dist/adapters/mock.d.ts",
      "browser": "./dist/shim.js",
      "import": "./dist/adapters/mock.mjs",
      "require": "./dist/adapters/mock.js"
    }
  },
  "browser": {
    "./dist/index.js": "./dist/shim.js",
    "./dist/adapters/node.js": "./dist/shim.js",
    "./dist/adapters/bun.js": "./dist/shim.js",
    "./dist/adapters/mock.js": "./dist/shim.js",
    "./dist/telemetry/index.js": "./dist/shim.js"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "igniter",
    "igniterjs",
    "collections",
    "content",
    "markdown",
    "md",
    "frontmatter",
    "parser",
    "typescript"
  ],
  "author": "Felipe Barcelos <felipebarcelospro@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/felipebarcelospro/igniter-js.git",
    "directory": "packages/collections"
  },
  "bugs": {
    "url": "https://github.com/felipebarcelospro/igniter-js/issues"
  },
  "homepage": "https://igniterjs.com",
  "dependencies": {
    "@igniter-js/common": ">=0.1.0",
    "@types/bun": "^1.3.9",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "handlebars": "^4.7.8",
    "jiti": "^2.4.0",
    "minisearch": "^7.2.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@igniter-js/common": "*",
    "@igniter-js/telemetry": "*",
    "@standard-schema/spec": "^1.0.0",
    "@types/node": "^22.19.13",
    "@types/uuid": "^10.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "zod": "^4.2.1"
  },
  "peerDependencies": {
    "@igniter-js/common": ">=0.1.0",
    "@igniter-js/telemetry": "*",
    "zod": ">=4.2.1"
  },
  "peerDependenciesMeta": {
    "@igniter-js/telemetry": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
